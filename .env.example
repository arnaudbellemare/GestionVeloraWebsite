# Contact form - get a free access key at https://web3forms.com
# In Web3Forms, set the form recipient to info@gestionvelora.com (demo & communication use clear email subjects).
# Copy to .env.local and rebuild. If unset, the form opens mailto:info@gestionvelora.com.
VITE_WEB3FORMS_ACCESS_KEY=

# Analytics. Prefer GTM so GA4 tags and custom dimensions can be managed without a rebuild.
# If VITE_GTM_ID is set, VITE_GA4_MEASUREMENT_ID is ignored by the browser loader.
VITE_GTM_ID=
VITE_GA4_MEASUREMENT_ID=
